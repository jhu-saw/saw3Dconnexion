/* -*- Mode: Javascript; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
{
    "$id": "dvrk-system.schema.json",
    "$version": "1",
    "component_manager": {
        "components": [
            {
                "shared-library": "saw3Dconnexion",
                "class-name": "mts3Dconnexion",
                "constructor-arg": {
                    "Name": "SpaceMouse"
                },
                "configure-parameter": "saw3Dconnexion-MTMR-Spaceball-5000.json"
            },
            {
                "shared-library": "dvrk_arm_from_ros",
                "class-name": "dvrk_psm_from_ros",
                "constructor-arg": {
                    "Name": "PSM1",
                    "Period": 0.01
                }
            }
        ]
    },
    "arms": [
        {
            "name": "MTMR",
            "type": "MTM_GENERIC",
            "component": "SpaceMouse",
            "interface": "MTMR"
        },
        {
            "name": "PSM1",
            "type": "PSM_GENERIC",
            "component": "PSM1",
            "interface": "PSM1",
            "skip_ROS_bridge": true
        }
    ],
    "consoles": [
        {
            "name": "console",
            "input_type": "SIMULATED",
            "teleop_PSMs": [
                {
                    "MTM": "MTMR",
                    "PSM": "PSM1",
                    "configure_parameter": {
                        "MTM_is_haptic": false,
                        "align_MTM": false,
                        "start_gripper_threshold": 0.0,
                        "ignore_jaw": false,
                        "use_MTM_velocity": false,
                        "scale": 4.0
                    }
                }
            ]
        }
    ]
}
